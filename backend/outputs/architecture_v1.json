        {
            "id": "GuestServiceReportingService",
            "name": "Guest Service & Reporting Service",
            "type": "Service",
            "trust_zone": "Application",
            "satisfies_requirements": [
                "FR-010",
                "FR-011"
            ]
        }
    ],
    "edges": [
        {
            "id": "GuestClient->EdgeGateway",
            "source": "GuestClient",
            "target": "EdgeGateway",
            "protocol": "HTTPS",
            "data": "Search, reservation, profile, and service-request data",
            "authentication": "OIDC session or guest session",
            "encryption": "TLS 1.3",
            "trust_boundary_crossing": true,
            "requirement_ids": [
                "FR-001",
                "FR-002",
                "FR-010",
                "SEC-001",
                "SEC-006",
                "SEC-008"
            ]
        },
        {
