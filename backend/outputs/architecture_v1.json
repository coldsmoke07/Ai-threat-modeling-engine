            "target": "EdgeGateway",
            "protocol": "HTTPS",
            "data": "Check-in, room status, rates, reports, and audit queries",
            "authentication": "MFA and role token",
            "encryption": "TLS 1.3",
            "trust_boundary_crossing": true,
            "requirement_ids": [
                "FR-003",
                "FR-005",
                "FR-008",
