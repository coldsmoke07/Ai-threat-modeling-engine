# Python environments and generated bytecode
.venv/
venv/
backend/.venv/
**/__pycache__/
*.py[cod]

# Frontend/build tooling
node_modules/
dist/

# Local configuration and secrets
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Temporary and generated files
*.tmp
*.log
*.swp
*.swo

# User-provided PDFs stay in samples/ when intentionally published.
backend/uploads/*
!backend/uploads/.gitkeep

# Keep only the starter inputs in runtime outputs; other artifacts are generated.
backend/outputs/*
!backend/outputs/architecture_v1.json
!backend/outputs/requirements.json
!backend/outputs/presentation/
backend/outputs/presentation/*
!backend/outputs/presentation/presentation_v1.json

